# Debian system files (safe to include, just metadata)
base-passwd
debianutils
perl-base

# System initialization (SysVinit - Alpine doesn't use, but safe)
sysvinit-utils

# Missing recommended packages and dev headers (not in hard dependencies but needed for compat)
npm
libssl-dev
libreadline-dev
libncurses-dev
cmake-data
procps
tcl

# libc6-dev: explicit safety net (also in repack-override, but ensure it's in repack.list)
libc6-dev

# Compat test transitive deps (not reached by 1-level closure)
# Python runtime libs (needed by python3-dev deps)
libpython3.11
libpython3.11-minimal
libpython3.11-stdlib
python3-lib2to3
python3-distutils
# Sphinx JS (required by python3-dev → python3-sphinx chain)
libjs-jquery
libjs-underscore
libjs-sphinxdoc
# TCL/TK runtime (needed by tcl package)
libtcl8.6
tcl8.6
# libmd (needed by dpkg)
libmd0
# Kerberos/SASL (needed by libcurl4 and openssl)
libgssapi-krb5-2
libkrb5-3
libkrb5support0
libk5crypto3
libkeyutils1
libsasl2-2
libsasl2-modules-db
libdb5.3
# LDAP (needed by libcurl4)
libldap-2.5-0
libldap-common
# Other common transitive deps
libgssapi3-heimdal
libhcrypto5-heimdal
libheimbase1-heimdal
libwind0-heimdal
# libgnutls30 transitive deps (needed by curl → libgnutls30)
libunistring2
libhogweed6
libnettle8
libidn2-0
libpsl5
librtmp1
libp11-kit0
libtasn1-6
# Python dev transitive deps
libpython3.11-dev
libpython3.11
libpython3-dev
# C++ stdlib dev (needed by g++-12)
libstdc++-12-dev
# GCC runtime sanitizer libraries (deps of gcc-12, 3rd-level from build-essential)
libitm1
libasan8
liblsan0
libtsan2
libubsan1
libquadmath0
libgomp1
# libc6-dev transitive deps (3rd-level from build-essential → libc6-dev)
libc-dev-bin
linux-libc-dev
libcrypt-dev
libnsl-dev
rpcsvc-proto
